---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
interface Props {
  title: string;
  description: string;
  theme?: 'portal' | 'tech' | 'living';
  /** SEO */
  path?: string;
  type?: 'website' | 'article';
  image?: string;
  publishedTime?: string;
  modifiedTime?: string;
  authorName?: string;
  jsonLd?: any[];
}
const { title, description, theme = 'portal', path, type = 'website', image, publishedTime, modifiedTime, authorName, jsonLd } = Astro.props;
const pagePath = path || Astro.url.pathname;
---
<!doctype html>
<html lang="id" class={`theme-${theme}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={title}
      description={description}
      type={type}
      path={pagePath}
      image={image}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      authorName={authorName}
      jsonLd={jsonLd}
    />
    <meta name="theme-color" content="#faf9f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0d0b" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Lofa RSS" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script is:inline>
      // Dark mode: simpan preferensi, default ikut sistem
      (function () {
        var saved = null;
        try { saved = localStorage.getItem('lofa-theme'); } catch (e) {}
        var dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (dark) document.documentElement.classList.add('dark');
        document.documentElement.classList.add('js');
      })();
    </script>
  </head>
  <body class="min-h-screen">
    <!-- Navbar glassmorphism -->
    <header class="sticky top-0 z-50 border-b border-line/80 bg-canvas/75 backdrop-blur-xl transition-colors dark:border-line-dark/70 dark:bg-canvas-dark/75">
      <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5 sm:h-[72px] sm:px-8">
        <a href="/" class="flex items-center gap-1.5 text-[22px] font-extrabold tracking-tight text-ink dark:text-ink-dark" aria-label="Lofa — beranda">
          Lofa<span class="text-accent dark:text-accent-dark">.</span>
        </a>

        <nav class="hidden items-center gap-7 md:flex" aria-label="Navigasi utama">
          <a href="/tech/" class="text-[15px] font-medium text-ink-soft transition hover:text-ink dark:text-ink-soft-dark dark:hover:text-ink-dark">Teknologi</a>
          <a href="/living/" class="text-[15px] font-medium text-ink-soft transition hover:text-ink dark:text-ink-soft-dark dark:hover:text-ink-dark">Kehidupan</a>
          <a href="/about/" class="text-[15px] font-medium text-ink-soft transition hover:text-ink dark:text-ink-soft-dark dark:hover:text-ink-dark">Tentang</a>
        </nav>

        <div class="flex items-center gap-2.5">
          <button id="searchBtn" class="flex h-10 items-center gap-2 rounded-full border border-line bg-surface px-3.5 text-sm text-ink-faint transition hover:border-ink/30 dark:border-line-dark dark:bg-surface-dark dark:text-ink-faint-dark dark:hover:border-ink-dark/30" aria-label="Cari artikel (Ctrl K)">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <span class="hidden sm:inline">Cari</span>
            <kbd class="hidden rounded-md border border-line px-1.5 py-0.5 text-[10px] font-semibold text-ink-faint md:inline dark:border-line-dark dark:text-ink-faint-dark">Ctrl K</kbd>
          </button>

          <button id="themeToggle" class="flex h-10 w-10 items-center justify-center rounded-full border border-line bg-surface text-ink-soft transition hover:border-ink/30 dark:border-line-dark dark:bg-surface-dark dark:text-ink-soft-dark dark:hover:border-ink-dark/30" aria-label="Ganti tema terang/gelap">
            <!-- sun (muncul di dark) -->
            <svg id="iconSun" xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden dark:block" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"/></svg>
            <!-- moon (muncul di light) -->
            <svg id="iconMoon" xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="dark:hidden" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          </button>

          <button id="menuBtn" class="flex h-10 w-10 items-center justify-center rounded-full border border-line bg-surface text-ink-soft md:hidden dark:border-line-dark dark:bg-surface-dark dark:text-ink-soft-dark" aria-label="Buka menu" aria-expanded="false">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
        </div>
      </div>

      <!-- Mobile menu -->
      <div id="mobileMenu" class="hidden border-t border-line bg-canvas px-5 py-4 md:hidden dark:border-line-dark dark:bg-canvas-dark">
        <nav class="flex flex-col gap-1" aria-label="Navigasi mobile">
          <a href="/" class="rounded-xl px-3 py-2.5 text-[15px] font-medium text-ink-soft hover:bg-surface-2 dark:text-ink-soft-dark dark:hover:bg-surface-2-dark">Beranda</a>
          <a href="/tech/" class="rounded-xl px-3 py-2.5 text-[15px] font-medium text-ink-soft hover:bg-surface-2 dark:text-ink-soft-dark dark:hover:bg-surface-2-dark">Teknologi</a>
          <a href="/living/" class="rounded-xl px-3 py-2.5 text-[15px] font-medium text-ink-soft hover:bg-surface-2 dark:text-ink-soft-dark dark:hover:bg-surface-2-dark">Kehidupan</a>
          <a href="/about/" class="rounded-xl px-3 py-2.5 text-[15px] font-medium text-ink-soft hover:bg-surface-2 dark:text-ink-soft-dark dark:hover:bg-surface-2-dark">Tentang</a>
        </nav>
      </div>
    </header>

    <!-- Reading progress -->
    <div id="readingProgress" class="fixed left-0 top-0 z-[60] h-[3px] w-0 bg-accent dark:bg-accent-dark" aria-hidden="true"></div>

    <main id="main" class="mx-auto w-full max-w-7xl px-5 pb-24 sm:px-8">
      <slot />
    </main>

    <!-- Footer minimal -->
    <footer class="border-t border-line py-14 dark:border-line-dark">
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
          <div class="max-w-xs">
            <p class="text-xl font-extrabold tracking-tight text-ink dark:text-ink-dark">Lofa<span class="text-accent dark:text-accent-dark">.</span></p>
            <p class="mt-3 text-sm leading-relaxed text-ink-faint">Teknologi & kehidupan sehari-hari. Catatan ringkas, panduan praktis, dan rekomendasi yang jujur.</p>
          </div>
          <div class="flex gap-16">
            <div>
              <p class="mb-3 text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint">Kategori</p>
              <ul class="space-y-2.5 text-[15px]">
                <li><a href="/tech/" class="text-ink-soft transition hover:text-ink dark:text-ink-soft-dark dark:hover:text-ink-dark">Teknologi</a></li>
                <li><a href="/living/" class="text-ink-soft transition hover:text-ink dark:text-ink-soft-dark dark:hover:text-ink-dark">Kehidupan</a></li>
              </ul>
            </div>
            <div>
              <p class="mb-3 text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint">Informasi</p>
              <ul class="space-y-2.5 text-[15px]">
                <li><a href="/about/" class="text-ink-soft transition hover:text-ink dark:text-ink-soft-dark dark:hover:text-ink-dark">Tentang</a></li>
                <li><a href="/contact/" class="text-ink-soft transition hover:text-ink dark:text-ink-soft-dark dark:hover:text-ink-dark">Kontak</a></li>
                <li><a href="/privacy/" class="text-ink-soft transition hover:text-ink dark:text-ink-soft-dark dark:hover:text-ink-dark">Privasi</a></li>
                <li><a href="/disclaimer/" class="text-ink-soft transition hover:text-ink dark:text-ink-soft-dark dark:hover:text-ink-dark">Disclaimer</a></li>
              </ul>
            </div>
          </div>
        </div>
        <div class="mt-12 flex items-center justify-between border-t border-line pt-6 dark:border-line-dark">
          <p class="text-sm text-ink-faint">© 2026 Lofa.</p>
          <button id="footerBackToTop" class="flex h-10 w-10 items-center justify-center rounded-full border border-line text-ink-soft transition hover:border-accent hover:text-accent dark:border-line-dark dark:text-ink-soft-dark dark:hover:border-accent-dark dark:hover:text-accent-dark" aria-label="Kembali ke atas">↑</button>
        </div>
      </div>
    </footer>

    <!-- Back to top floating -->
    <button id="backToTop" class="fixed bottom-6 right-6 z-50 flex h-11 w-11 items-center justify-center rounded-full bg-ink text-canvas opacity-0 shadow-lg transition-all duration-300 hover:-translate-y-1 dark:bg-ink-dark dark:text-canvas-dark" aria-label="Kembali ke atas">↑</button>

    <!-- Search overlay -->
    <div id="searchOverlay" class="fixed inset-0 z-[70] hidden items-start justify-center bg-black/40 p-4 pt-[12vh] backdrop-blur-sm" role="dialog" aria-modal="true" aria-label="Cari artikel">
      <div class="w-full max-w-lg overflow-hidden rounded-3xl border border-line bg-surface shadow-2xl dark:border-line-dark dark:bg-surface-dark">
        <div class="flex items-center gap-3 border-b border-line px-5 dark:border-line-dark">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-ink-faint" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <input id="searchOverlayInput" type="search" placeholder="Cari artikel… (misal: keyboard, sayuran)" class="h-14 w-full bg-transparent text-[15px] text-ink outline-none placeholder:text-ink-faint dark:text-ink-dark" autocomplete="off" aria-label="Kata kunci pencarian" />
          <kbd class="rounded-md border border-line px-1.5 py-0.5 text-[10px] font-semibold text-ink-faint dark:border-line-dark dark:text-ink-faint-dark">Esc</kbd>
        </div>
        <div id="searchOverlayResults" class="max-h-[50vh] overflow-y-auto p-2">
          <p class="px-3 py-6 text-center text-sm text-ink-faint">Ketik untuk mencari artikel…</p>
        </div>
      </div>
    </div>

    <script>
      // ===== Theme toggle =====
      var themeBtn = document.getElementById('themeToggle');
      if (themeBtn) {
        themeBtn.addEventListener('click', function () {
          var root = document.documentElement;
          var dark = root.classList.toggle('dark');
          try { localStorage.setItem('lofa-theme', dark ? 'dark' : 'light'); } catch (e) {}
        });
      }

      // ===== Mobile menu =====
      var menuBtn = document.getElementById('menuBtn');
      var mobileMenu = document.getElementById('mobileMenu');
      if (menuBtn && mobileMenu) {
        menuBtn.addEventListener('click', function () {
          var open = mobileMenu.classList.toggle('hidden');
          menuBtn.setAttribute('aria-expanded', String(!open));
        });
      }

      // ===== Scroll reveal =====
      var els = document.querySelectorAll('.reveal');
      if (els.length) {
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
            });
          }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
          els.forEach(function (el) { io.observe(el); });
        } else {
          els.forEach(function (el) { el.classList.add('visible'); });
        }
      }

      // ===== Reading progress =====
      var bar = document.getElementById('readingProgress');
      if (bar) {
        function updateBar() {
          var h = document.documentElement;
          var total = h.scrollHeight - h.clientHeight;
          bar.style.width = (total > 0 ? (h.scrollTop / total) * 100 : 0) + '%';
        }
        window.addEventListener('scroll', updateBar, { passive: true });
        updateBar();
      }

      // ===== Back to top =====
      function bindBackToTop(btn) {
        if (!btn) return;
        window.addEventListener('scroll', function () {
          btn.classList.toggle('opacity-0', window.scrollY < 400);
          btn.classList.toggle('opacity-100', window.scrollY >= 400);
        }, { passive: true });
        btn.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });
      }
      bindBackToTop(document.getElementById('backToTop'));
      bindBackToTop(document.getElementById('footerBackToTop'));

      // ===== Search =====
      // Kumpulkan data artikel dari halaman (data-search attribute di cards)
      var searchBtn = document.getElementById('searchBtn');
      var overlay = document.getElementById('searchOverlay');
      var overlayInput = document.getElementById('searchOverlayInput');
      var overlayResults = document.getElementById('searchOverlayResults');
      var searchCards = Array.prototype.slice.call(document.querySelectorAll('[data-search]'));

      function openSearch() {
        if (!overlay) return;
        overlay.classList.remove('hidden');
        overlay.classList.add('flex');
        setTimeout(function () { overlayInput && overlayInput.focus(); }, 30);
      }
      function closeSearch() {
        if (!overlay) return;
        overlay.classList.add('hidden');
        overlay.classList.remove('flex');
        if (overlayInput) overlayInput.value = '';
        renderResults('');
      }
      function renderResults(q) {
        if (!overlayResults) return;
        q = (q || '').trim().toLowerCase();
        if (!q) {
          overlayResults.innerHTML = '<p class="px-3 py-6 text-center text-sm text-ink-faint">Ketik untuk mencari artikel…</p>';
          return;
        }
        var matches = searchCards.filter(function (c) {
          return (c.getAttribute('data-search') || '').toLowerCase().indexOf(q) !== -1;
        });
        if (!matches.length) {
          overlayResults.innerHTML = '<p class="px-3 py-6 text-center text-sm text-ink-faint">Tidak ada artikel yang cocok.</p>';
          return;
        }
        overlayResults.innerHTML = matches.map(function (c) {
          var title = c.getAttribute('data-title') || '';
          var cat = c.getAttribute('data-cat') || '';
          var url = c.getAttribute('data-url') || '#';
          var img = c.getAttribute('data-img');
          var thumb = img
            ? '<img src="' + img + '" alt="" loading="lazy" class="h-11 w-16 shrink-0 rounded-lg object-cover">'
            : '<span class="flex h-11 w-16 shrink-0 items-center justify-center rounded-lg bg-surface-2 text-lg dark:bg-surface-2-dark">📄</span>';
          return '<a href="' + url + '" class="flex items-center gap-3 rounded-2xl px-3 py-2.5 transition hover:bg-surface-2 dark:hover:bg-surface-2-dark">'
            + thumb
            + '<span class="min-w-0"><span class="block truncate text-[14px] font-semibold text-ink dark:text-ink-dark">' + title + '</span>'
            + '<span class="block text-xs text-ink-faint">' + cat + '</span></span></a>';
        }).join('');
      }
      if (searchBtn && overlay) {
        searchBtn.addEventListener('click', openSearch);
        overlay.addEventListener('click', function (e) { if (e.target === overlay) closeSearch(); });
        if (overlayInput) {
          overlayInput.addEventListener('input', function () { renderResults(overlayInput.value); });
        }
        document.addEventListener('keydown', function (e) {
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); openSearch(); }
          if (e.key === 'Escape') closeSearch();
        });
      }

      // ===== Live filter (instant, halaman yang punya #cardsGrid) =====
      var liveInput = document.getElementById('liveSearchInput');
      var grid = document.getElementById('cardsGrid');
      if (liveInput && grid) {
        liveInput.addEventListener('input', function () {
          var q = liveInput.value.trim().toLowerCase();
          var cards = grid.querySelectorAll('[data-search]');
          var visible = 0;
          cards.forEach(function (c) {
            var ok = !q || (c.getAttribute('data-search') || '').toLowerCase().indexOf(q) !== -1;
            c.style.display = ok ? '' : 'none';
            if (ok) visible++;
          });
          var empty = document.getElementById('searchEmpty');
          if (visible === 0) {
            if (!empty) {
              empty = document.createElement('p');
              empty.id = 'searchEmpty';
              empty.className = 'py-10 text-center text-ink-faint';
              empty.textContent = 'Tidak ada artikel yang cocok.';
              grid.appendChild(empty);
            }
          } else if (empty) { empty.remove(); }
        });
      }

      // ===== Salin link =====
      document.querySelectorAll('.btn-copy').forEach(function (b) {
        b.addEventListener('click', function () {
          var url = b.getAttribute('data-url');
          function done() {
            var old = b.textContent;
            b.textContent = '✅ Link disalin!';
            setTimeout(function () { b.textContent = old; }, 1800);
          }
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url).then(done, function () { fallbackCopy(url, done); });
          } else { fallbackCopy(url, done); }
        });
      });
      function fallbackCopy(text, done) {
        var ta = document.createElement('textarea');
        ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select();
        try { document.execCommand('copy'); done(); } catch (e) {}
        document.body.removeChild(ta);
      }

      // ===== Newsletter =====
      var nf = document.getElementById('newsletterForm');
      if (nf) {
        nf.addEventListener('submit', function (e) {
          e.preventDefault();
          var email = document.getElementById('newsletterEmail').value.trim();
          if (email) {
            try {
              var list = JSON.parse(localStorage.getItem('lofa_newsletter') || '[]');
              if (list.indexOf(email) === -1) list.push(email);
              localStorage.setItem('lofa_newsletter', JSON.stringify(list));
            } catch (err) {}
          }
          nf.style.display = 'none';
          document.getElementById('newsletterOk').hidden = false;
        });
      }
    </script>
  </body>
</html>
