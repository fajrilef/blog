---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('blog')).filter((p) => !p.data.draft).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const catLabel = { tech: 'Teknologi', living: 'Kehidupan' };
const fmt = (d) => d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
const readTime = (p) => Math.max(1, Math.round(p.body ? p.body.split(/\s+/).length / 200 : 3));
const slugOf = (p) => p.id.split('/').slice(1).join('/').replace(/\.(md|mdx)$/, '');
const techCount = all.filter((p) => p.data.category === 'tech').length;
const livingCount = all.filter((p) => p.data.category === 'living').length;
---
<Layout title="Lofa — Teknologi & kehidupan sehari-hari" description="Catatan ringkas, panduan praktis, dan rekomendasi yang jujur." theme="portal">
  <div class="pt-10 sm:pt-14">
    <p class="mb-3 text-xs font-bold uppercase tracking-[0.18em] text-[color:var(--accent)]">Blog</p>
    <h1 class="max-w-2xl text-4xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-5xl">
      Teknologi & kehidupan sehari-hari<span class="text-[color:var(--accent)]">.</span>
    </h1>
    <p class="mt-4 max-w-xl text-lg text-slate-500">Catatan ringkas, panduan praktis, dan rekomendasi yang jujur dari Lofa.</p>
  </div>

  <!-- Kategori -->
  <section class="mt-10 grid gap-5 sm:grid-cols-2">
    <a href="/blog/tech/" class="reveal group relative overflow-hidden rounded-3xl border border-blue-100 bg-gradient-to-br from-blue-50 via-white to-sky-100 p-7 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-blue-100">
      <span class="text-3xl">⚙️</span>
      <h2 class="mt-3 text-xl font-bold text-slate-900">Teknologi</h2>
      <p class="mt-1.5 text-sm leading-relaxed text-slate-500">Review, tutorial, dan tips produk teknologi — keyboard, gadget, perangkat kerja.</p>
      <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-blue-600">Lihat {techCount} artikel <span class="transition-transform group-hover:translate-x-1">→</span></span>
      <div class="pointer-events-none absolute -right-6 -top-6 h-28 w-28 rounded-full bg-blue-200/40 blur-2xl"></div>
    </a>
    <a href="/blog/living/" class="reveal group relative overflow-hidden rounded-3xl border border-emerald-100 bg-gradient-to-br from-emerald-50 via-white to-lime-100 p-7 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-emerald-100">
      <span class="text-3xl">🏠</span>
      <h2 class="mt-3 text-xl font-bold text-slate-900">Kehidupan</h2>
      <p class="mt-1.5 text-sm leading-relaxed text-slate-500">Rumah tangga, produktivitas, dan hal-hal sehari-hari yang berguna.</p>
      <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-emerald-600">Lihat {livingCount} artikel <span class="transition-transform group-hover:translate-x-1">→</span></span>
      <div class="pointer-events-none absolute -right-6 -top-6 h-28 w-28 rounded-full bg-emerald-200/40 blur-2xl"></div>
    </a>
  </section>

  <!-- All posts -->
  <section class="mt-14">
    <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">All posts</h2>
      <input type="search" id="searchInput" placeholder="Cari artikel… (misal: keyboard, sayuran)" aria-label="Cari artikel" class="w-full max-w-xs rounded-full border border-slate-200 bg-white px-4 py-2 text-sm text-slate-700 outline-none transition focus:border-[color:var(--accent)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--accent)_20%,transparent)]" />
    </div>
    <div id="cardsGrid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {all.map((p) => (
        <PostCard
          title={p.data.title}
          url={`/blog/${p.data.category}/${slugOf(p)}/`}
          date={fmt(p.data.pubDate)}
          readTime={readTime(p)}
          categoryLabel={catLabel[p.data.category]}
          excerpt={p.data.description}
          tags={p.data.tags}
          cover={p.data.cover}
        />
      ))}
    </div>
  </section>

  <!-- Newsletter -->
  <section class="reveal mt-16 overflow-hidden rounded-3xl border p-8 text-center sm:p-12" style="border-color: color-mix(in srgb, var(--accent) 20%, transparent); background: color-mix(in srgb, var(--accent) 6%, white);">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Jangan lewatkan update</h2>
    <p class="mx-auto mt-2 max-w-md text-slate-500">Artikel baru dikirim langsung ke inbox-mu. Tanpa spam.</p>
    <form id="newsletterForm" class="mx-auto mt-6 flex max-w-md flex-col gap-3 sm:flex-row">
      <input type="email" id="newsletterEmail" placeholder="Masukkan email kamu" required aria-label="Email" class="flex-1 rounded-full border border-slate-200 bg-white px-5 py-3 text-sm outline-none transition focus:border-[color:var(--accent)]" />
      <button type="submit" class="rounded-full bg-slate-900 px-7 py-3 text-sm font-semibold text-white transition hover:bg-slate-700">Berlangganan</button>
    </form>
    <p id="newsletterOk" class="mt-4 font-medium text-[color:var(--accent)]" hidden>✅ Terima kasih! Kamu akan mendapat update artikel terbaru.</p>
  </section>
</Layout>
