---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return [
    { params: { cat: 'tech' } },
    { params: { cat: 'living' } },
  ];
}

const { cat } = Astro.params;
const all = (await getCollection('blog')).filter((p) => !p.data.draft && p.id.startsWith(cat + '/')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const meta = {
  tech: { label: 'Teknologi', emoji: '⚙️', desc: 'Review, tutorial, dan tips produk teknologi — keyboard, gadget, perangkat kerja.', theme: 'tech' },
  living: { label: 'Kehidupan', emoji: '🏠', desc: 'Rumah tangga, produktivitas, dan hal-hal sehari-hari yang berguna.', theme: 'living' },
}[cat];
const other = cat === 'tech' ? 'living' : 'tech';
const catLabel = { tech: 'Teknologi', living: 'Kehidupan' };
const fmt = (d) => d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
const readTime = (p) => Math.max(1, Math.round((p.body || '').split(/\s+/).length / 200));
const slugOf = (p) => p.id.split('/').slice(1).join('/').replace(/\.(md|mdx)$/, '');
---
<Layout
  title={`${meta.label} — Lofa`}
  description={meta.desc}
  theme={meta.theme}
  path={`/${cat}/`}
>
  <!-- Header kategori -->
  <section class="pt-14 sm:pt-20 md:pt-24">
    <p class="mb-4 text-xs font-bold uppercase tracking-[0.22em] text-accent dark:text-accent-dark">{meta.emoji} Kategori</p>
    <h1 class="display text-[42px] leading-[1.05] sm:text-[56px] md:text-[68px]">{meta.label}</h1>
    <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-soft dark:text-ink-soft-dark">{meta.desc}</p>
  </section>

  <!-- Category pills -->
  <section class="mt-10">
    <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter kategori">
      <a href="/" class="rounded-full border border-line bg-surface px-5 py-2.5 text-sm font-medium text-ink-soft transition hover:border-accent/40 hover:text-ink dark:border-line-dark dark:bg-surface-dark dark:text-ink-soft-dark dark:hover:text-ink-dark">Semua</a>
      <a href="/tech/" class={`rounded-full border px-5 py-2.5 text-sm font-semibold transition ${cat === 'tech' ? 'border-ink bg-ink text-canvas dark:border-ink-dark dark:bg-ink-dark dark:text-canvas-dark' : 'border-line bg-surface text-ink-soft hover:border-accent/40 hover:text-ink dark:border-line-dark dark:bg-surface-dark dark:text-ink-soft-dark dark:hover:text-ink-dark'}`}>⚙️ Teknologi</a>
      <a href="/living/" class={`rounded-full border px-5 py-2.5 text-sm font-semibold transition ${cat === 'living' ? 'border-ink bg-ink text-canvas dark:border-ink-dark dark:bg-ink-dark dark:text-canvas-dark' : 'border-line bg-surface text-ink-soft hover:border-accent/40 hover:text-ink dark:border-line-dark dark:bg-surface-dark dark:text-ink-soft-dark dark:hover:text-ink-dark'}`}>🏠 Kehidupan</a>
    </div>
  </section>

  <!-- Grid artikel -->
  <section class="mt-10 sm:mt-12">
    <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
      <h2 class="display text-2xl tracking-tight sm:text-3xl">{all.length} artikel</h2>
      <input
        id="liveSearchInput"
        type="search"
        placeholder={`Cari di ${meta.label.toLowerCase()}…`}
        aria-label="Cari artikel"
        class="w-full max-w-[280px] rounded-full border border-line bg-surface px-4 py-2.5 text-sm text-ink outline-none transition placeholder:text-ink-faint focus:border-accent/50 focus:ring-2 focus:ring-accent/15 sm:w-64 dark:border-line-dark dark:bg-surface-dark dark:text-ink-dark dark:placeholder:text-ink-faint-dark"
      />
    </div>
    <div id="cardsGrid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 md:gap-8">
      {all.length > 0 && (
        <PostCard
          title={all[0].data.title}
          url={`/${cat}/${slugOf(all[0])}/`}
          date={fmt(all[0].data.pubDate)}
          readTime={readTime(all[0])}
          categoryLabel={catLabel[cat]}
          excerpt={all[0].data.description}
          tags={all[0].data.tags}
          cover={all[0].data.cover}
          large
        />
      )}
      {all.slice(1).map((p) => (
        <PostCard
          title={p.data.title}
          url={`/${cat}/${slugOf(p)}/`}
          date={fmt(p.data.pubDate)}
          readTime={readTime(p)}
          categoryLabel={catLabel[cat]}
          excerpt={p.data.description}
          tags={p.data.tags}
          cover={p.data.cover}
        />
      ))}
    </div>
    {all.length === 0 && <p class="py-16 text-center text-ink-faint">Belum ada artikel di kategori ini.</p>}
  </section>
</Layout>
