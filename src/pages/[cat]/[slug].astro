---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((p) => {
    const parts = p.id.split('/');
    const cat = parts[0];
    const slug = parts.slice(1).join('/').replace(/\.(md|mdx)$/, '');
    return {
      params: { cat, slug },
      props: { post: p },
    };
  });
}

const { post } = Astro.props;
const { Content } = await render(post);
const slugOf = (p) => p.id.split('/').slice(1).join('/').replace(/\.(md|mdx)$/, '');
const all = (await getCollection('blog')).filter((p) => !p.data.draft && p.data.category === post.data.category && slugOf(p) !== slugOf(post)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const catLabel = { tech: 'Teknologi', living: 'Kehidupan' };
const fmt = (d) => d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
const readTime = Math.max(1, Math.round((post.body || '').split(/\s+/).length / 200));
const tags = post.data.tags || [];
const related = all.slice(0, 2);
const pageUrl = `https://fajrilef.github.io/blog/${post.data.category}/${post.slug}/`;
const cat = post.data.category;
const theme = cat === 'tech' ? 'tech' : 'living';
---
<Layout title={`${post.data.title} — Lofa`} description={post.data.description} theme={theme} image={`/assets/img/${post.data.cover}`}>
  <article class="mx-auto max-w-3xl pt-10 sm:pt-14">
    <nav class="mb-6 text-sm text-slate-400">
      <a href="/blog/" class="transition hover:text-[color:var(--accent)]">Beranda</a>
      <span class="mx-2">/</span>
      <a href={`/blog/${cat}/`} class="transition hover:text-[color:var(--accent)]">{catLabel[cat]}</a>
    </nav>

    {post.data.cover && (
      <img src={`/blog/assets/img/${post.data.cover}`} alt={post.data.title} fetchpriority="high" class="mb-8 w-full rounded-2xl object-cover shadow-lg" style="max-height: 420px;" />
    )}

    <h1 class="text-3xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-4xl">{post.data.title}</h1>
    <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-slate-400">
      <span class="rounded-full px-3 py-1 font-semibold text-[color:var(--accent)] bg-[color-mix(in_srgb,var(--accent)_10%,transparent)]">{catLabel[cat]}</span>
      <span>{fmt(post.data.pubDate)} · {readTime} menit baca</span>
    </div>

    <div class="prose-blog mt-8">
      <Content />
    </div>

    {tags.length > 0 && (
      <div class="mt-8 flex flex-wrap gap-2">
        {tags.map((t) => <span class="rounded-full bg-slate-100 px-3 py-1 text-sm text-slate-500">{t}</span>)}
      </div>
    )}

    <div class="mt-10 flex flex-wrap gap-3 border-t border-slate-200 pt-6">
      <button class="btn-copy rounded-full border border-slate-200 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-[color:var(--accent)] hover:text-[color:var(--accent)]" data-url={pageUrl}>🔗 Salin link</button>
      <a class="rounded-full border border-slate-200 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-[color:var(--accent)] hover:text-[color:var(--accent)]" target="_blank" rel="noopener" href={`https://t.me/share/url?url=${pageUrl}&text=${encodeURIComponent(post.data.title)}`}>📨 Bagikan ke Telegram</a>
    </div>
  </article>

  {related.length > 0 && (
    <section class="mx-auto mt-16 max-w-6xl">
      <h2 class="mb-5 text-2xl font-bold tracking-tight text-slate-900">Baca juga</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        {related.map((r) => (
          <PostCard
            title={r.data.title}
            url={`/blog/${r.data.category}/${slugOf(r)}/`}
            date={fmt(r.data.pubDate)}
            readTime={Math.max(1, Math.round((r.body || '').split(/\s+/).length / 200))}
            categoryLabel={catLabel[r.data.category]}
            excerpt={r.data.description}
            tags={r.data.tags}
            cover={r.data.cover}
          />
        ))}
      </div>
    </section>
  )}
</Layout>
