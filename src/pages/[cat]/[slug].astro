---
import Layout from '../../layouts/Layout.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import RecommendedProducts from '../../components/RecommendedProducts.astro';
import { getCollection, render } from 'astro:content';
import { AUTHOR, authorLd } from '../../lib/author';
import { slugOf, readTimeOf, fmtDate, CAT_LABELS, findRelated } from '../../lib/article';
import { getRecommendedProducts } from '../../lib/products';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((p) => {
    const parts = p.id.split('/');
    const cat = parts[0];
    const slug = parts.slice(1).join('/').replace(/\.(md|mdx)$/, '');
    return {
      params: { cat, slug },
      props: { post: p },
    };
  });
}

const { post } = Astro.props;
const { Content } = await render(post);
const all = (await getCollection('blog')).filter((p) => !p.data.draft).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const catLabel = CAT_LABELS;
const fmt = fmtDate;
const readTime = readTimeOf(post.body);
const tags = post.data.tags || [];
// Related: kategori sama → tag cocok → terbaru — maks 3, tanpa artikel ini
const relatedPosts = findRelated(all, post, 3);
const related = relatedPosts.map((p) => ({
  title: p.data.title,
  url: `/${p.data.category}/${slugOf(p)}/`,
  date: fmt(p.data.pubDate),
  readTime: readTimeOf(p.body),
  categoryLabel: catLabel[p.data.category],
  excerpt: p.data.description,
  tags: p.data.tags,
  cover: p.data.cover,
}));
const pageUrl = `https://lofa.web.id/${post.data.category}/${slugOf(post)}/`;
const pagePath = `/${post.data.category}/${slugOf(post)}/`;
const cat = post.data.category;
const theme = cat === 'tech' ? 'tech' : 'living';
// Prev/next navigation (berdasarkan urutan tanggal)
const idx = all.findIndex((p) => slugOf(p) === slugOf(post));
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : null;
const prevLabel = prev ? catLabel[prev.data.category] : null;
const nextLabel = next ? catLabel[next.data.category] : null;
const publishedISO = post.data.pubDate.toISOString();
const modifiedISO = post.data.updatedDate ? post.data.updatedDate.toISOString() : publishedISO;
// Produk rekomendasi — SELALU 3 produk: spesifik dari frontmatter, fallback kategori tech/living
const recommended = getRecommendedProducts(post.data.recommendedProducts, cat === 'tech' ? 'tech' : 'living', 3);

// JSON-LD: BlogPosting + BreadcrumbList
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://lofa.web.id/' },
    { '@type': 'ListItem', position: 2, name: catLabel[cat], item: `https://lofa.web.id/${cat}/` },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: pageUrl },
  ],
};
---
<Layout
  title={`${post.data.title} — Lofa`}
  description={post.data.description}
  theme={theme}
  path={pagePath}
  type="article"
  image={post.data.cover}
  publishedTime={publishedISO}
  modifiedTime={modifiedISO}
  authorName={AUTHOR.name}
  jsonLd={[breadcrumbLd, authorLd()]}
>
  <article class="mx-auto max-w-[760px] pt-12 sm:pt-16 md:pt-20">
    <!-- Meta atas -->
    <nav class="mb-8 flex flex-wrap items-center gap-2 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="transition hover:text-ink dark:hover:text-ink-dark">Beranda</a>
      <span aria-hidden="true">/</span>
      <a href={`/${cat}/`} class="transition hover:text-ink dark:hover:text-ink-dark">{catLabel[cat]}</a>
      <span aria-hidden="true">/</span>
      <span class="text-ink-soft dark:text-ink-soft-dark" aria-current="page">{post.data.title}</span>
    </nav>

    <div class="mb-5 flex flex-wrap items-center gap-3 text-sm">
      <span class="rounded-full bg-accent-soft px-3.5 py-1.5 text-[13px] font-semibold text-accent dark:bg-accent-soft-dark dark:text-accent-dark">{catLabel[cat]}</span>
      <span class="text-ink-faint">{fmt(post.data.pubDate)} · {readTime} menit baca</span>
      <span class="text-ink-faint" aria-label="Penulis">· oleh <span class="font-medium text-ink-soft dark:text-ink-soft-dark">{AUTHOR.name}</span></span>
    </div>

    <h1 class="display text-[32px] leading-[1.12] sm:text-[44px] md:text-[52px]">{post.data.title}</h1>

    <p class="mt-6 border-l-2 border-accent pl-5 text-lg leading-relaxed text-ink-soft dark:border-accent-dark dark:text-ink-soft-dark">{post.data.description}</p>

    <!-- Hero image -->
    {post.data.cover && (
      <img
        src={`/assets/img/${post.data.cover}`}
        alt={post.data.title}
        fetchpriority="high"
        width="1600"
        height="900"
        class="mt-10 aspect-[16/9] w-full rounded-[24px] object-cover"
      />
    )}

    <!-- Body -->
    <div class="prose-blog mt-12">
      <Content />
    </div>

    <!-- Tags -->
    {tags.length > 0 && (
      <div class="mt-12 flex flex-wrap gap-2">
        {tags.map((t) => <span class="rounded-full border border-line px-3.5 py-1.5 text-[13px] text-ink-faint dark:border-line-dark dark:text-ink-faint-dark">#{t}</span>)}
      </div>
    )}

    <!-- Share -->
    <div class="mt-10 flex flex-wrap items-center gap-3 border-t border-line pt-8 dark:border-line-dark">
      <span class="text-sm font-semibold text-ink dark:text-ink-dark">Bagikan:</span>
      <button class="btn-copy flex h-11 items-center gap-2 rounded-full border border-line px-5 text-sm font-medium text-ink-soft transition hover:border-accent/50 hover:text-accent dark:border-line-dark dark:text-ink-soft-dark dark:hover:border-accent-dark/50 dark:hover:text-accent-dark" data-url={pageUrl} aria-label="Salin link artikel">🔗 Salin link</button>
      <a class="flex h-11 items-center gap-2 rounded-full border border-line px-5 text-sm font-medium text-ink-soft transition hover:border-accent/50 hover:text-accent dark:border-line-dark dark:text-ink-soft-dark dark:hover:border-accent-dark/50 dark:hover:text-accent-dark" target="_blank" rel="noopener" href={`https://api.whatsapp.com/send?text=${encodeURIComponent(post.data.title + ' — ' + pageUrl)}`} aria-label="Bagikan ke WhatsApp">💬 WhatsApp</a>
      <a class="flex h-11 items-center gap-2 rounded-full border border-line px-5 text-sm font-medium text-ink-soft transition hover:border-accent/50 hover:text-accent dark:border-line-dark dark:text-ink-soft-dark dark:hover:border-accent-dark/50 dark:hover:text-accent-dark" target="_blank" rel="noopener" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`} aria-label="Bagikan ke Facebook">📘 Facebook</a>
      <a class="flex h-11 items-center gap-2 rounded-full border border-line px-5 text-sm font-medium text-ink-soft transition hover:border-accent/50 hover:text-accent dark:border-line-dark dark:text-ink-soft-dark dark:hover:border-accent-dark/50 dark:hover:text-accent-dark" target="_blank" rel="noopener" href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(post.data.title)}`} aria-label="Bagikan ke X (Twitter)">𝕏 X</a>
      <a class="flex h-11 items-center gap-2 rounded-full border border-line px-5 text-sm font-medium text-ink-soft transition hover:border-accent/50 hover:text-accent dark:border-line-dark dark:text-ink-soft-dark dark:hover:border-accent-dark/50 dark:hover:text-accent-dark" target="_blank" rel="noopener" href={`https://t.me/share/url?url=${pageUrl}&text=${encodeURIComponent(post.data.title)}`} aria-label="Bagikan ke Telegram">📨 Telegram</a>
    </div>

    <!-- Author block -->
    <aside class="mt-12 flex items-start gap-4 rounded-[20px] border border-line bg-surface p-6 dark:border-line-dark dark:bg-surface-dark" aria-label="Tentang penulis">
      <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-ink text-lg font-bold text-canvas dark:bg-ink-dark dark:text-canvas-dark" aria-hidden="true">L</span>
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint">Ditulis oleh</p>
        <p class="mt-1 text-[15px] font-bold text-ink dark:text-ink-dark">{AUTHOR.name}</p>
        <p class="mt-1.5 text-sm leading-relaxed text-ink-soft dark:text-ink-soft-dark">{AUTHOR.description}</p>
      </div>
    </aside>
  </article>

  <!-- Recommended products -->
  <RecommendedProducts products={recommended} />

  <!-- Prev / Next -->
  <nav class="mx-auto mt-14 grid max-w-[760px] gap-4 sm:grid-cols-2" aria-label="Navigasi artikel">
    {prev ? (
      <a href={`/${prev.data.category}/${slugOf(prev)}/`} class="group rounded-[20px] border border-line bg-surface p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/40 dark:border-line-dark dark:bg-surface-dark dark:hover:border-accent-dark/40">
        <span class="text-xs font-semibold uppercase tracking-wider text-ink-faint">← Sebelumnya · {prevLabel}</span>
        <span class="mt-2 block text-[15px] font-semibold leading-snug text-ink transition group-hover:text-accent dark:text-ink-dark dark:group-hover:text-accent-dark">{prev.data.title}</span>
      </a>
    ) : <span></span>}
    {next ? (
      <a href={`/${next.data.category}/${slugOf(next)}/`} class="group rounded-[20px] border border-line bg-surface p-6 text-right transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/40 dark:border-line-dark dark:bg-surface-dark dark:hover:border-accent-dark/40">
        <span class="text-xs font-semibold uppercase tracking-wider text-ink-faint">Selanjutnya · {nextLabel} →</span>
        <span class="mt-2 block text-[15px] font-semibold leading-snug text-ink transition group-hover:text-accent dark:text-ink-dark dark:group-hover:text-accent-dark">{next.data.title}</span>
      </a>
    ) : <span></span>}
  </nav>

  <!-- Related -->
  <RelatedArticles items={related} title="Artikel Terkait" />
</Layout>
