---
import Layout from '../layouts/Layout.astro';
---
<Layout title="404 — Lofa" description="Halaman tidak ditemukan" theme="portal" path="/404.html">
  <div class="flex min-h-[55vh] flex-col items-center justify-center pt-24 text-center">
    <p class="display text-[80px] leading-none text-ink dark:text-ink-dark sm:text-[120px]">404<span class="text-accent dark:text-accent-dark">.</span></p>
    <p class="mt-4 text-lg text-ink-soft dark:text-ink-soft-dark">Halaman tidak ditemukan.</p>
    <p class="mt-1 text-ink-faint">Kamu sedang berada di <strong class="text-ink dark:text-ink-dark">Lofa</strong> — catatan teknologi & kehidupan sehari-hari.</p>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <a href="/" class="rounded-full bg-ink px-8 py-3.5 text-[15px] font-semibold text-canvas transition hover:opacity-85 dark:bg-ink-dark dark:text-canvas-dark">Kembali ke Beranda</a>
      <a href="/tech/" class="rounded-full border border-line px-8 py-3.5 text-[15px] font-semibold text-ink-soft transition hover:border-accent/50 hover:text-accent dark:border-line-dark dark:text-ink-soft-dark dark:hover:border-accent-dark/50 dark:hover:text-accent-dark">Jelajahi Artikel</a>
    </div>
  </div>
</Layout>
