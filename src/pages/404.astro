---
import Layout from '../layouts/Layout.astro';
---
<Layout title="404 — Lofa" description="Halaman tidak ditemukan" theme="portal">
  <div class="flex min-h-[50vh] flex-col items-center justify-center pt-20 text-center">
    <h1 class="text-7xl font-extrabold tracking-tight text-slate-900">404<span class="text-[color:var(--accent)]">.</span></h1>
    <p class="mt-4 text-lg text-slate-500">Halaman yang kamu cari tidak ditemukan.</p>
    <p class="mt-1 text-slate-400">Kamu sedang berada di <strong>Lofa</strong> — catatan teknologi & kehidupan sehari-hari.</p>
    <a href="/blog/" class="mt-8 rounded-full bg-slate-900 px-7 py-3 text-sm font-semibold text-white transition hover:bg-slate-700">← Kembali ke beranda</a>
  </div>
</Layout>
