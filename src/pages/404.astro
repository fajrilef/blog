---
import Layout from '../layouts/Layout.astro';
---
<Layout title="404 — Lofa" description="Halaman tidak ditemukan" theme="portal">
  <div class="flex min-h-[55vh] flex-col items-center justify-center pt-24 text-center">
    <p class="display text-[80px] leading-none text-ink dark:text-ink-dark sm:text-[120px]">404<span class="text-accent dark:text-accent-dark">.</span></p>
    <p class="mt-4 text-lg text-ink-soft dark:text-ink-soft-dark">Halaman yang kamu cari tidak ditemukan.</p>
    <p class="mt-1 text-ink-faint">Kamu sedang berada di <strong class="text-ink dark:text-ink-dark">Lofa</strong> — catatan teknologi & kehidupan sehari-hari.</p>
    <a href="/blog/" class="mt-9 rounded-full bg-ink px-8 py-3.5 text-[15px] font-semibold text-canvas transition hover:opacity-85 dark:bg-ink-dark dark:text-canvas-dark">← Kembali ke beranda</a>
  </div>
</Layout>
